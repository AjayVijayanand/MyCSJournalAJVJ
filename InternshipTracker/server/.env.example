# Copy this file to .env and fill in your own values. Never commit .env.

# From MongoDB Atlas: Connect > Drivers. Replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://tracker-user:<password>@cluster0.xxxxx.mongodb.net/internship-tracker?retryWrites=true&w=majority

# Websites allowed to call this API, separated by commas
ALLOWED_ORIGINS=https://ajayvijayanand.github.io,http://localhost:5500,http://127.0.0.1:5500
